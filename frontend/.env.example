# ArthSathi Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Backend API URL (Express server)
NEXT_PUBLIC_API_URL=http://localhost:3001

# IVR Phone Number (displayed on homepage, dashboard, footer)
NEXT_PUBLIC_IVR_NUMBER=02248963501

# WhatsApp Number (for wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER=+14155238886

# Telegram Bot Username (for t.me links)
NEXT_PUBLIC_TELEGRAM_USERNAME=arthsathi_demo_bot
